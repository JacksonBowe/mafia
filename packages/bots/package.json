{
	"name": "@mafia/bots",
	"version": "0.0.0",
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"start": "sst shell -- bun run src/index.ts",
		"panel": "sst shell -- bun run src/panel.ts",
		"panel:prod": "MAFIA_BOTS_CONFIG=prod sst shell --stage prod -- bun run src/panel.ts",
		"format": "prettier --write . --config ../../.prettierrc.json",
		"lint": "eslint ."
	},
	"dependencies": {
		"@mafia/core": "workspace:",
		"@mafia/sdk": "workspace:",
		"@opentui/core": "^0.4.1",
		"mqtt": "^5.14.1",
		"sst": "4.8.0",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@mafia/engine": "workspace:",
		"@mafia/functions": "workspace:",
		"@types/bun": "latest"
	}
}
